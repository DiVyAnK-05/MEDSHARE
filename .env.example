# MedShare Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave MONGODB_URI empty in dev to automatically use in-memory MongoDB
# or provide your local/Atlas URI:
# MONGODB_URI=mongodb://localhost:27017/medshare
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/medshare?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret & Cookie Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Client Origin
CLIENT_URL=http://localhost:5000

# Minimum Shelf Life for Donation (in days, e.g. 90 = 3 months)
MIN_SHELF_LIFE_DAYS=90
